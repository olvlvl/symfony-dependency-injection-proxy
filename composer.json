{
  "name": "olvlvl/symfony-dependency-injection-proxy",
  "type": "library",
  "description": "Generate super tiny proxies for Symfony's dependency injection",
  "keywords": [ "symfony", "dependency", "injection", "proxy" ],
  "homepage": "https://olvlvl.com/",
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Olivier Laviale",
      "email": "olivier.laviale@gmail.com",
      "homepage": "https://olvlvl.com/",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/olvlvl/symfony-dependency-injection-proxy/issues",
    "source": "https://github.com/olvlvl/symfony-dependency-injection-proxy"
  },
  "config": {
    "platform": {
      "php": "8.4.1"
    },
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=8.4.1",
    "ext-json": "*",
    "symfony/dependency-injection": "^8.1"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^13.4",
    "symfony/config": "^8.0"
  },
  "autoload": {
    "psr-4": {
      "olvlvl\\SymfonyDependencyInjectionProxy\\": "lib"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "tests\\olvlvl\\SymfonyDependencyInjectionProxy\\": "tests"
    }
  }
}
